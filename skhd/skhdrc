# Shared skhd configuration.

.shell "/bin/dash"

# Default mode: reset SketchyBar colors.
:: default : \
  sketchybar --bar color=0xff1d1d2d \
  --set /./ \
    label.color=0xfff5e0dc \
  --set /space/ \
    label.background.color=0xff313244 \
    icon.highlight_color=0xffeba0ac \
  --set /volume/ icon.color=0xfff38ba8 \
  --set /apple/ icon.color=0xffa6e3a1

.define set_sketchybar_bg : sketchybar --bar color={{1}}

# Prefix mode: left control + semicolon.
:: prefix @ : @set_sketchybar_bg("0x61dc8a78")

default < lctrl - 0x29 ; prefix

# Window mode: dark purple SketchyBar.
:: window @ : @set_sketchybar_bg("0xa18839ef")

# Splits mode: dark blue SketchyBar.
:: splits @ : @set_sketchybar_bg("0x611e66f5")

# Desktop mode: dark green SketchyBar.
:: desktop @ : @set_sketchybar_bg("0x9140a02b")

####### MODE SWITCHING

prefix < d ; desktop
prefix < w ; window
prefix < s ; splits

# 0x9A is an unused keycode that gives the modes one-shot behavior.
prefix < 0x9A ; default
window < 0x9A ; default
desktop < 0x9A ; default
splits < 0x9A ; default

# Escape key always returns to the default mode.
prefix < escape ; default
window < escape ; default
desktop < escape ; default
splits < escape ; default

####### SHARED BINDINGS

# Open the quick terminal (Ghostty).
prefix < t : skhd -k "ctrl + alt + cmd - t"; skhd -k "0x9A"

.alias $lowper cmd + alt + ctrl

# Enable exactly one window manager configuration.
.load "aerospace.skhdrc"
# .load "yabai.skhdrc"

# Shortcuts emitted by the custom keyboard firmware.
default < hyper - 5 : skhd -k "shift + cmd - 5"
default < hyper - 2 : skhd -k "shift + cmd - 2"
default < hyper - a : skhd -k "cmd - a"
default < hyper - c : skhd -k "cmd - c"
default < hyper - v : skhd -k "cmd - v"
default < hyper - return : skhd -k "shift - return"
default < hyper - delete : skhd -k "alt - delete"
default < hyper - q : skhd -k "lctrl + alt + shift - q"
