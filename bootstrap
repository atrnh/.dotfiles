#!/usr/bin/env sh

CONF_DIR=${XDG_CONFIG_HOME:-"$HOME/.config"}
export CONF_DIR

if ! command -v stow >/dev/null 2>&1; then
  echo "GNU Stow is required. Install it with: brew install stow" >&2
  exit 1
fi

# Create ~/.config directory if it doesn't exist.
mkdir -p "$CONF_DIR"
parent_dir=$(cd "$(dirname "$0")" && pwd -P)

for package_dir in "$parent_dir"/*/; do
  name=$(basename "$package_dir")
  target_dir="$CONF_DIR/$name"

  # Migrate directory symlinks created by older versions of this script.
  if [ -L "$target_dir" ]; then
    source_path=$(cd "$package_dir" && pwd -P)
    target_path=$(cd "$target_dir" && pwd -P)
    if [ "$source_path" != "$target_path" ]; then
      echo "Skipping $name: $target_dir points somewhere else" >&2
      continue
    fi
    unlink "$target_dir"
  fi

  mkdir -p "$target_dir"
  if stow --simulate --restow --dir "$parent_dir" --target "$target_dir" "$name" >/dev/null 2>&1; then
    stow --restow --dir "$parent_dir" --target "$target_dir" "$name"
  else
    echo "Skipping $name: existing files conflict with the Stow package" >&2
  fi
done

if [ ! -e "$HOME/.gitconfig" ]; then
  ln -s "$parent_dir/.gitconfig" "$HOME/.gitconfig"
fi
